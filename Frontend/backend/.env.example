GROQ_API_KEY=your_groq_api_key_here
# GROQ_API_KEYS: comma-separated list of 3-5 Groq account keys for rate-limit
# fallback — a rate-limited call rotates to the next key instead of failing.
GROQ_API_KEYS=key1,key2,key3,key4,key5
GROQ_MODEL_LARGE=openai/gpt-oss-120b
GROQ_MODEL_SMALL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.7

# Optional second fallback tier, tried after every Groq key is exhausted.
# Same model slugs work on both providers (openai/gpt-oss-20b, -120b).
OPEN_ROUTER_API_KEY=your_openrouter_api_key_here
